#!/bin/sh
#
# dfx_fw_install
#
# Copy a single Kria/DFX firmware directory from inside an OCI container
# onto a bind-mounted host directory so that the host's dfx-mgr daemon can
# load it. Designed to be invoked once per firmware name with the host's
# /lib/firmware/xilinx/<fw> bound over the container's destination path:
#
#   sudo mkdir -p /lib/firmware/xilinx/${FW_NAME}
#   docker run --rm \
#       -v /lib/firmware/xilinx/${FW_NAME}:/opt/firmware/xilinx/${FW_NAME} \
#       <image> dfx_fw_install --fw-name ${FW_NAME}
#
# Defaults:
#   --src  /lib/firmware/xilinx/<fw-name>      (container path)
#   --host-dir /opt/firmware/xilinx/<fw-name>  (bind-mounted from host)

set -eu

FW_NAME=""
SRC=""
DEST=""
FORCE=0
LIST=0
DRY_RUN=0

print_usage() {
    cat <<EOF
Usage: $0 --fw-name <name> [--src <src-dir>] [--host-dir <dest-dir>]
                          [--force] [--list] [--dry-run]

Options:
  --fw-name NAME    Firmware name (required). Defaults:
                      src       = /lib/firmware/xilinx/NAME
                      host-dir  = /opt/firmware/xilinx/NAME
  --src DIR         Override the container source directory.
  --host-dir DIR    Override the (bind-mounted) destination directory.
  --force           Overwrite existing files in the destination.
                    Without --force, existing files are kept untouched.
  --list            Print the files that would be installed and exit.
  --dry-run         Run rsync in dry-run mode and exit (no writes).
  -h, --help        Show this help message.
EOF
}

error() {
    echo "ERROR: $*" >&2
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --fw-name)
            shift; [ $# -gt 0 ] || error "--fw-name requires an argument"
            FW_NAME="$1" ;;
        --src)
            shift; [ $# -gt 0 ] || error "--src requires an argument"
            SRC="$1" ;;
        --host-dir|--dest)
            shift; [ $# -gt 0 ] || error "--host-dir requires an argument"
            DEST="$1" ;;
        --force)   FORCE=1 ;;
        --list)    LIST=1 ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help) print_usage; exit 0 ;;
        *)         error "Unknown argument: $1" ;;
    esac
    shift
done

[ -n "$FW_NAME" ] || { print_usage; error "--fw-name is required"; }

# Sanity: don't accept a name with a path separator. Keeps this tool to its
# stated scope of a single per-firmware bind-mount and prevents arbitrary
# directory traversal via --fw-name.
case "$FW_NAME" in
    */*|..*|.*/*) error "--fw-name must not contain path separators" ;;
esac

[ -n "$SRC" ]  || SRC="/lib/firmware/xilinx/${FW_NAME}"
[ -n "$DEST" ] || DEST="/opt/firmware/xilinx/${FW_NAME}"

echo "dfx_fw_install: fw-name='${FW_NAME}'"
echo "  src     : ${SRC}"
echo "  host-dir: ${DEST}"

[ -d "$SRC" ] || error "source directory '${SRC}' does not exist"
if ! find "$SRC" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
    echo "Source directory '${SRC}' is empty. Nothing to copy."
    exit 0
fi

if [ "$LIST" -eq 1 ]; then
    find "$SRC" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort
    exit 0
fi

# rsync flags:
#   -a       archive (perms, timestamps, symlinks)
#   --info=stats1,progress0
#            print a small summary, no per-file noise
#   --ignore-existing  refuse to overwrite (safe by default)
#   -c       checksum-based when --force is in play, so we only rewrite
#            files whose content actually changed
RSYNC_OPTS="-a --info=stats1,progress0"
if [ "$FORCE" -eq 1 ]; then
    # Drop --ignore-existing, add -c so we only rewrite changed files.
    RSYNC_OPTS="${RSYNC_OPTS} -c"
else
    RSYNC_OPTS="${RSYNC_OPTS} --ignore-existing"
fi
if [ "$DRY_RUN" -eq 1 ]; then
    RSYNC_OPTS="${RSYNC_OPTS} --dry-run"
fi

# Ensure the destination exists. If --host-dir was bind-mounted, this is a
# no-op; if it wasn't, we land in the OCI overlay (visible only inside the
# container). Print a clear note so the user notices when they forgot the
# bind mount.
if [ ! -d "$DEST" ]; then
    echo "Destination '${DEST}' does not exist; creating it."
    mkdir -p "$DEST"
fi
if ! mountpoint -q "$DEST" 2>/dev/null; then
    echo "WARNING: '${DEST}' is not a bind mount; copy will land inside the"
    echo "         container's writable layer and be lost when it exits."
fi

# Trailing slash on src so we copy *contents*, not the directory itself.
# shellcheck disable=SC2086
rsync ${RSYNC_OPTS} "${SRC}/" "${DEST}/"

# Make sure bytes hit the host filesystem before dfx-mgr tries to read them.
if [ "$DRY_RUN" -ne 1 ]; then
    sync -f "${DEST}" 2>/dev/null || sync
fi

echo "dfx_fw_install: done."
